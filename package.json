{
  "name": "swip-customs-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A production-shaped slice of a cross-border customs compliance pipeline: ingest product data, classify (HS code), assess duty/tax/compliance, route by confidence, human-in-the-loop review.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "inngest:dev": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "db:up": "docker compose up -d",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "pipeline": "tsx scripts/run-one.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "kb:build": "tsx scripts/build-kb.ts",
    "kb:enrich": "tsx scripts/enrich-kb.ts",
    "rag:test": "tsx scripts/test-retrieve.ts",
    "rag:compare": "tsx scripts/compare-rag.ts",
    "rag:recall": "tsx scripts/recall-at-k.ts",
    "rag:eval": "tsx scripts/eval-accuracy.ts",
    "rag:holdout": "tsx scripts/eval-holdout.ts",
    "rag:askback": "tsx scripts/eval-askback.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.0",
    "inngest": "^3.27.0",
    "next": "^15.1.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp", "esbuild", "protobufjs"]
  }
}
